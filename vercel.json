{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin(.*)",
      "has": [
        {
          "type": "host",
          "value": "accesplay.com"
        }
      ],
      "destination": "/404.html",
      "permanent": false
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/",
        "has": [
          {
            "type": "host",
            "value": "admin.accesplay.com"
          }
        ],
        "destination": "/admin"
      }
    ]
  }
}