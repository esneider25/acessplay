{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/",
        "has": [
          {
            "type": "host",
            "value": "admin.accesplay.com"
          }
        ],
        "destination": "/admin.html"
      },
      {
        "source": "/",
        "has": [
          {
            "type": "host",
            "value": "admin.acessplay.com"
          }
        ],
        "destination": "/admin.html"
      }
    ]
  }
}