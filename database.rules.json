{
  "rules": {
    "pins": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "pin_redemptions": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "products": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "categories": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "exchange_rate": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "payment_methods": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "settings": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "landing_config": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "banners": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "tournaments": {
      ".read": "true",
      ".write": "auth != null && (auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".indexOn": ["createdAt", "status"],
      "$tournamentId": {
        ".write": "auth != null && (auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "participants": {
          ".read": "true",
          ".write": "false"
        },
        "participantsCount": {
          ".write": "auth != null && (auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "tournament_participants": {
      ".read": "true",
      "$tournamentId": {
        ".write": "auth != null && (auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "(!data.exists() && root.child('tournaments').child($tournamentId).child('status').val() === 'registration_open') || auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "tournament_global_stats": {
      ".read": "true",
      ".write": "auth != null && (auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "tournament_metadata": {
      ".read": "true",
      ".write": "auth != null && (auth.token.email === 'admin@accesplay.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "product_stats": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "messages": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'",
      "$sessionId": {
        ".read": "(auth != null && (auth.token.email === 'admin@accesplay.com' || auth.uid === $sessionId)) || $sessionId.matches(/^fp-/)",
        ".write": "(auth != null && (auth.token.email === 'admin@accesplay.com' || auth.uid === $sessionId)) || ($sessionId.matches(/^fp-/) && newData.exists())"
      }
    },
    "orders": {
      ".read": "auth != null && (auth.token.email === 'admin@accesplay.com' || (query.orderByChild == 'userId' && query.equalTo == auth.uid))",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".indexOn": [
        "userId",
        "id",
        "createdAt"
      ],
      "$orderId": {
        ".read": "!$orderId.beginsWith('AP-OLD-') || (auth != null && data.child('userId').val() === auth.uid) || (auth != null && auth.token.email === 'admin@accesplay.com')",
        ".write": "auth != null && auth.token.email === 'admin@accesplay.com' || (!data.exists() && newData.child('status').val() === 'pending' && (auth == null || newData.child('userId').val() === auth.uid)) || (data.exists() && (newData.child('status').val() === data.child('status').val() || (data.child('status').val() === 'invalid-id' && newData.child('status').val() === 'pending')) && newData.child('priceUsd').val() === data.child('priceUsd').val() && newData.child('priceBs').val() === data.child('priceBs').val() && (auth == null || data.child('userId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['id', 'productId', 'priceUsd', 'priceBs', 'status']) && newData.child('priceUsd').isNumber() && newData.child('priceUsd').val() >= 0 && newData.child('priceBs').isNumber() && newData.child('priceBs').val() >= 0",
        "roulettePlayed": {
          ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
        }
      }
    },
    "withdrawals": {
      ".read": "auth != null && (auth.token.email === 'admin@accesplay.com' || (query.orderByChild == 'userId' && query.equalTo == auth.uid))",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".indexOn": [
        "userId"
      ],
      "$wdId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || auth.token.email === 'admin@accesplay.com')",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'pending') || auth.token.email === 'admin@accesplay.com')"
      }
    },
    "telegram_config": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "discounts": {
      ".read": "true",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "_sysTracking": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "admin_logs": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "spam_tracker": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "order_counter": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "api_configs": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'"
    },
    "users": {
      ".read": "auth != null && auth.token.email === 'admin@accesplay.com'",
      ".write": "auth != null && auth.token.email === 'admin@accesplay.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@accesplay.com')",
        "role": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com' || (data.val() === 'influencer' && newData.val() === 'partner')"
        },
        "discountPercentage": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "isBlocked": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "wallet": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "points": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "totalSpent": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "referralsCount": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "referralsEarnedPoints": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "hasMadeFirstPurchase": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "referredBy": {
          ".validate": "!data.exists() || data.val() == newData.val() || newData.val() == null || auth.token.email === 'admin@accesplay.com'"
        },
        "referralCode": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "referralLimit": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        },
        "autoProcess": {
          ".validate": "!data.exists() || data.val() == newData.val() || auth.token.email === 'admin@accesplay.com'"
        }
      }
    }
  }
}